MONGO_URL=""
DB_NAME=""
CORS_ORIGINS="https://academy.hamptoncrestcapital.com"
JWT_SECRET=""
COOKIE_SECURE="true"
ALLOW_PUBLIC_REGISTRATION="false"

# Secure admin bootstrap. No public/default admin is created unless both are set.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FORCE_PASSWORD_RESET="false"

# Public application and payment URLs.
APP_PUBLIC_URL="https://academy.hamptoncrestcapital.com"
PAYMENT_LINK_URL=""
FRAMER_URL=""
MEMBERSHIP_PRICE_DISPLAY=""
MEMBERSHIP_BILLING_INTERVAL=""
SUPPORT_EMAIL="members@investorhamptoncrest.com"
OPS_ALERT_EMAIL=""

# Optional non-production test member seeding. Keep disabled in production.
ENABLE_TEST_MEMBER_SEED="false"
TEST_MEMBER_EMAIL=""
TEST_MEMBER_PASSWORD=""
TEST_MEMBER_NAME=""
TEST_CLEANUP_EMAILS=""

RESEND_API_KEY=""
SENDER_EMAIL=""
SENDER_NAME=""
EMERGENT_LLM_KEY=""
OPENAI_API_KEY=""
FMP_API_KEY=""
APP_NAME=""

# Private Academy book storage. Keep the service-role key server-side only.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BOOKS_BUCKET="academy-books"
# Optional override. Defaults to https://PROJECT_REF.storage.supabase.co/storage/v1/upload/resumable
SUPABASE_STORAGE_RESUMABLE_URL=""

# Stripe secret values. Configure only in .env or deployment secrets; do not expose in frontend.
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Number of days a renewing member keeps access after the first failed payment (0-30).
PAYMENT_GRACE_DAYS="5"
EMAILS_ENABLED=""

# Integration-test credentials. Never commit real values.
TEST_ADMIN_EMAIL=""
TEST_ADMIN_PASSWORD=""
TEST_STRIPE_WEBHOOK_SECRET=""
# Database migrations and indexes run through `python -m scripts.release_setup`.
# Keep request/startup setup disabled in production.
RUN_DB_SETUP_ON_STARTUP=false
SEED_ADMIN_ON_SETUP=false
