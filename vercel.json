{
  "version": 2,
  "installCommand": "npm install --prefix frontend --legacy-peer-deps",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "hampton-crest-academy.vercel.app" }
      ],
      "destination": "https://academy.hamptoncrestcapital.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com https://customer-assets.emergentagent.com; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://buy.stripe.com; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://buy.stripe.com\")" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/access-denied", "destination": "/index.html" },
    { "source": "/accept-invite", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/terminos", "destination": "/index.html" },
    { "source": "/privacidad", "destination": "/index.html" },
    { "source": "/aviso-de-riesgo", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/books", "destination": "/index.html" },
    { "source": "/books/:id", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" },
    { "source": "/research/:id", "destination": "/index.html" },
    { "source": "/education", "destination": "/index.html" },
    { "source": "/education/:id", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/reports/:id", "destination": "/index.html" },
    { "source": "/companies", "destination": "/index.html" },
    { "source": "/companies/:id", "destination": "/index.html" },
    { "source": "/valuation", "destination": "/index.html" },
    { "source": "/saved", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/directory", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/admin/members", "destination": "/index.html" }
  ]
}
